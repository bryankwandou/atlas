# Atlas Environment Configuration Example
# Copy to .env.local for local overrides.

# Session Secret (min 32 characters, mandatory in production)
SESSION_SECRET=dev-session-secret-change-this-in-production-at-least-32-chars

# Data Store (Defaults to .data/db.json)
ATLAS_DATA_FILE=.data/db.json

# Optional: Real OpenAI Provider (If unset, system runs in offline simulation mode)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL_LOW=gpt-5.6-luna
# OPENAI_MODEL_BALANCED=gpt-5.6-terra
# OPENAI_MODEL_FLAGSHIP=gpt-5.6-sol
# OPENAI_PRICE_INPUT_PER_M=0.20
# OPENAI_PRICE_OUTPUT_PER_M=1.20
